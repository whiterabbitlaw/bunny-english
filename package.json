{
  "name": "bunny-english",
  "private": true,
  "version": "1.0.0",
  "description": "小兔英语 Bunny English — a kindergarten English practice app for Chinese-speaking children ages 3–6.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43123 --strictPort",
    "build": "tsc -b && vite build",
    "build:pages": "APP_BASE=/bunny-english/ npm run build && node scripts/verify-pages-base.mjs dist /bunny-english/",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 43123 --strictPort",
    "preview:pages": "APP_BASE=/bunny-english/ vite preview --host 127.0.0.1 --port 43124 --strictPort",
    "test:e2e": "playwright test",
    "test:pages": "playwright test -c playwright.pages.config.ts",
    "test:homework": "node --test tests/homework/homework.test.cjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
